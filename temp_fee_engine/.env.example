# Firebase Web App configuration. Create these in Firebase Console > Project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Owner account used by the Owner / Super Admin portal in production.
VITE_OWNER_EMAIL=

# Development-only demo login. Leave unset in production.
VITE_ENABLE_DEMO_AUTH=false
